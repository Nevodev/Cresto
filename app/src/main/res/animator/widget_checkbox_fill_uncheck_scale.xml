<set xmlns:android="http://schemas.android.com/apk/res/android">
    <objectAnimator
        android:duration="1"
        android:interpolator="@android:interpolator/linear"
        android:propertyName="scaleX"
        android:startOffset="150"
        android:valueFrom="1"
        android:valueTo="0.5" />
    <objectAnimator
        android:duration="1"
        android:interpolator="@android:interpolator/linear"
        android:propertyName="scaleY"
        android:startOffset="150"
        android:valueFrom="1"
        android:valueTo="0.5" />
</set>
